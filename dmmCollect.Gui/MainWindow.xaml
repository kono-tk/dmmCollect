<Window x:Class="dmmCollect.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="dmmCollect コントロールパネル" Height="620" Width="820"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- モード -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="モード:" VerticalAlignment="Center" Width="70" />
            <RadioButton x:Name="ModeVideo" Content="video" GroupName="Mode" IsChecked="True" Margin="0,0,12,0" VerticalAlignment="Center" />
            <RadioButton x:Name="ModeBooks" Content="books" GroupName="Mode" Margin="0,0,12,0" VerticalAlignment="Center" />
            <RadioButton x:Name="ModeDojin" Content="dojin" GroupName="Mode" Margin="0,0,12,0" VerticalAlignment="Center" />
            <RadioButton x:Name="ModeDlsite" Content="dlsite" GroupName="Mode" VerticalAlignment="Center" />
        </StackPanel>

        <!-- キーワード / ページ数 -->
        <Grid Grid.Row="1" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="60" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="キーワード:" VerticalAlignment="Center" />
            <TextBox x:Name="KeywordBox" Grid.Column="1" VerticalAlignment="Center"
                     ToolTip="スペース区切りで複数指定。'-' でフラットモード。空欄なら自動検出。" />
            <TextBlock Grid.Column="2" Text="ページ数(books):" VerticalAlignment="Center" Margin="12,0,4,0" />
            <TextBox x:Name="PagesBox" Grid.Column="3" Text="1" VerticalAlignment="Center"
                     ToolTip="books モードの最大取得ページ数。0 で全ページ。" />
        </Grid>

        <!-- フラグ -->
        <WrapPanel Grid.Row="2" Margin="70,0,0,8">
            <CheckBox x:Name="ChkHeadful" Content="headful（ブラウザ表示）" Margin="0,0,16,0" />
            <CheckBox x:Name="ChkDebug" Content="debug（詳細ログ）" Margin="0,0,16,0" />
            <CheckBox x:Name="ChkSyncOnly" Content="sync-only（同期のみ）" Margin="0,0,16,0" />
            <CheckBox x:Name="ChkRenewLnk" Content="renew-lnk（.lnk再作成）" Margin="0,0,16,0" />
            <CheckBox x:Name="ChkLostChild" Content="lost-child（孤立検索）" />
        </WrapPanel>

        <!-- 実行 / 停止 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="RunButton" Content="▶ 実行" Width="120" Height="30" Margin="0,0,10,0" Click="RunButton_Click" />
            <Button x:Name="StopButton" Content="■ 停止" Width="120" Height="30" IsEnabled="False" Click="StopButton_Click" />
            <TextBlock x:Name="StatusText" Text="待機中" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#555" />
        </StackPanel>

        <!-- ログ見出し -->
        <DockPanel Grid.Row="4" Margin="0,4,0,4">
            <TextBlock Text="ログ" FontWeight="Bold" VerticalAlignment="Center" />
            <CheckBox x:Name="ChkAutoScroll" Content="自動追尾" IsChecked="True" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" />
            <Button x:Name="ClearLogButton" Content="クリア" DockPanel.Dock="Right" HorizontalAlignment="Right" Width="60" Margin="0,0,8,0" Click="ClearLogButton_Click" />
        </DockPanel>

        <!-- ログ本文 -->
        <TextBox x:Name="LogBox" Grid.Row="5"
                 IsReadOnly="True" IsReadOnlyCaretVisible="False"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap" FontFamily="Consolas, MS Gothic" FontSize="12"
                 Background="#1E1E1E" Foreground="#DDDDDD" />
    </Grid>
</Window>
